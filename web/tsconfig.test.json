{
  /* The app's settings, plus Node's types: tests read fixtures with node:fs. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/vite-env.d.ts"],
  /* Replaces the app's `exclude`, which leaves the tests out. */
  "exclude": []
}
